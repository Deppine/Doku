# ชื่อแบรนด์ที่แสดงบนเว็บ
NEXT_PUBLIC_APP_NAME=Doku

# URL ของเว็บ (ใช้สร้างลิงก์ widget สำหรับ OBS)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ผู้ตรวจสลิป: "mock" (อนุมัติทุกสลิป), "test" (กรอกข้อมูลสลิปเองเพื่อทดสอบการตรวจ), "local" (อ่านสลิปในเครื่อง ฟรี แต่ไม่ได้ยืนยันกับธนาคาร) หรือ "easyslip" (ตรวจกับธนาคารผ่าน API)
SLIP_PROVIDER=local
SLIP_API_KEY=

# อายุ QR (นาที)
SESSION_TTL_MINUTES=15

# ฐานข้อมูล MySQL/MariaDB: mysql://ผู้ใช้:รหัสผ่าน@host:พอร์ต/ชื่อฐานข้อมูล
# ถ้าใช้ docker-compose.yml: mysql://donate:donatepass@127.0.0.1:3306/donate
DATABASE_URL=mysql://donate:donatepass@127.0.0.1:3306/donate
# Aiven: DATABASE_URL=mysql://avnadmin:<password>@<host>.aivencloud.com:<port>/defaultdb?ssl-mode=REQUIRED
# CA certificate จาก Aiven: ในเครื่องใส่ชื่อไฟล์ได้เลย เช่น DATABASE_CA=ca.pem (วางไฟล์ไว้ในโฟลเดอร์โปรเจกต์)
# บน Vercel ให้วางเนื้อหาไฟล์ทั้งก้อน (-----BEGIN CERTIFICATE----- ...)
DATABASE_CA=
# จำนวน connection ต่อ instance (serverless ควรน้อยๆ)
DATABASE_POOL_SIZE=5

# กุญแจลงลายเซ็นคุกกี้ล็อกอิน สุ่มยาว ๆ อย่างน้อย 32 ตัว ห้ามแชร์
SESSION_SECRET=

# ที่เก็บรูปสลิป/ไฟล์เสียง: ไม่ใส่ = เก็บในฐานข้อมูล (ใช้กับ Vercel ได้)
# UPLOAD_STORAGE=disk = เก็บในโฟลเดอร์ UPLOAD_DIR (ไม่ใส่ = โฟลเดอร์ uploads ในโปรเจกต์)
UPLOAD_STORAGE=
UPLOAD_DIR=

# เปิดให้สมัครสมาชิกเองที่ /register (false = ให้ผู้ดูแลสร้างบัญชีให้อย่างเดียว)
REGISTRATION_OPEN=true
# คนที่สมัครเองต้องรอผู้ดูแลอนุมัติก่อนหน้าโดเนทเปิด (false = ใช้ได้ทันที)
REGISTRATION_APPROVAL=true
